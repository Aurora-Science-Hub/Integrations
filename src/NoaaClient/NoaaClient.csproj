<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>AuroraScienceHub.Integrations.NoaaClient</AssemblyName>
    <PackageId>AuroraScienceHub.Integrations.NoaaClient</PackageId>
    <Description>NOAA space weather data integration client for ACE, DSCOVR spacecraft and KP-index data</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AuroraScienceHub.Framework.Http" />
    <PackageReference Include="AuroraScienceHub.Framework.Utilities" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>

  <PropertyGroup Label="Package info">
    <PackageDescription>
      Provides unified HTTP client interfaces for accessing NOAA space weather data including solar wind measurements, magnetometer data, and geomagnetic activity indices from ACE and DSCOVR spacecraft with KP-index forecasts and nowcast data.
    </PackageDescription>
    <PackageTags>noaa;space-weather;ace;dscovr;kp-index;solar-wind;magnetometer;geomagnetic;aurora;integration</PackageTags>
  </PropertyGroup>

</Project>
