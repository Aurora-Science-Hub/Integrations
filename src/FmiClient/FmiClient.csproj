<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>AuroraScienceHub.Integrations.FmiClient</AssemblyName>
    <PackageId>AuroraScienceHub.Integrations.FmiClient</PackageId>
    <Description>Finnish Meteorological Institute real-time electrojet indices client</Description>
    <PackageDescription>HTTP client for FMI real-time IU and IL electrojet indices</PackageDescription>
    <PackageTags>fmi;eurisgic;iu;il;electrojet;space-weather;geomagnetic;aurora;integration</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AuroraScienceHub.Framework.Http" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>
</Project>
